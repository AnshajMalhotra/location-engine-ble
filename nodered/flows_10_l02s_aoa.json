  {
    "id": "59ad664d3594a699",
    "type": "function",
    "z": "1382c88ee6232ec0",
    "name": "Test Case Validation",
    "func": "// L02S Test Case Validation Node\n// Place this node after the JOIN node\n\nlet p = msg.payload;\n\n// -----------------------------\n// 1. Test case configuration\n// -----------------------------\nlet testCaseId = flow.get(\"test_case_id\") || \"TC01\";\nlet testPhase = flow.get(\"test_phase\") || \"Basic SensorInfo Verification\";\n\n// Temperature limit for healthcare refrigerator use case\nlet tempMin = 0;\nlet tempMax = 6;\n\n// -----------------------------\n// 2. Refrigerator geofence area\n// Change these values based on your actual refrigerator/cold-zone coordinates\n// -----------------------------\nlet fridgeZone = {\n    x_min: 1.0,\n    x_max: 3.0,\n    y_min: 2.0,\n    y_max: 4.0,\n    z_min: 0.0,\n    z_max: 2.0\n};\n\n// -----------------------------\n// 3. Read final joined values\n// -----------------------------\nlet temperature = Number(p.temperature);\nlet x = Number(p.x);\nlet y = Number(p.y);\nlet z = Number(p.z);\n\n// -----------------------------\n// 4. Temperature check\n// -----------------------------\nlet temperatureStatus = \"UNKNOWN\";\nlet temperatureAlarm = false;\n\nif (!isNaN(temperature)) {\n    if (temperature >= tempMin && temperature <= tempMax) {\n        temperatureStatus = \"OK\";\n        temperatureAlarm = false;\n    } else if (temperature > tempMax) {\n        temperatureStatus = \"HIGH_TEMP\";\n        temperatureAlarm = true;\n    } else if (temperature < tempMin) {\n        temperatureStatus = \"LOW_TEMP\";\n        temperatureAlarm = true;\n    }\n}\n\n// -----------------------------\n// 5. Geofence check\n// -----------------------------\nlet insideFridgeZone = false;\n\nif (!isNaN(x) && !isNaN(y) && !isNaN(z)) {\n    insideFridgeZone =\n        x >= fridgeZone.x_min &&\n        x <= fridgeZone.x_max &&\n        y >= fridgeZone.y_min &&\n        y <= fridgeZone.y_max &&\n        z >= fridgeZone.z_min &&\n        z <= fridgeZone.z_max;\n}\n\nlet geofenceStatus = insideFridgeZone ? \"INSIDE\" : \"OUTSIDE\";\nlet geofenceAlarm = !insideFridgeZone;\n\n// -----------------------------\n// 6. Final test status\n// -----------------------------\nlet finalStatus = \"UNKNOWN\";\nlet alertMessage = \"\";\n\nif (temperatureAlarm && geofenceAlarm) {\n    finalStatus = \"CRITICAL\";\n    alertMessage = \"Tag is outside refrigerator zone and temperature is outside allowed range.\";\n} else if (temperatureAlarm) {\n    finalStatus = \"TEMP_ALERT\";\n    alertMessage = \"Temperature is outside allowed range.\";\n} else if (geofenceAlarm) {\n    finalStatus = \"GEOFENCE_ALERT\";\n    alertMessage = \"Tag is outside refrigerator zone.\";\n} else {\n    finalStatus = \"OK\";\n    alertMessage = \"Temperature and location are within expected range.\";\n}\n\n// -----------------------------\n// 7. Final output for debug / file / Excel report\n// -----------------------------\nmsg.payload = {\n    test_case_id: testCaseId,\n    test_phase: testPhase,\n\n    tag_mac: p.mac || msg.topic,\n\n    temperature_celsius: temperature,\n    temperature_min_limit: tempMin,\n    temperature_max_limit: tempMax,\n    temperature_status: temperatureStatus,\n    temperature_alarm: temperatureAlarm,\n\n    x: x,\n    y: y,\n    z: z,\n\n    geofence_zone: \"Refrigerator Zone\",\n    geofence_status: geofenceStatus,\n    geofence_alarm: geofenceAlarm,\n\n    final_status: finalStatus,\n    alert_message: alertMessage,\n\n    timestamp: new Date().toISOString()\n};\n\nreturn msg;",
